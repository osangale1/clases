# --- LLM y embeddings: Gemini (tier gratuito) por defecto ---
# Key gratis en https://aistudio.google.com/apikey
GOOGLE_API_KEY=tu_api_key_de_gemini
LLM_PROVIDER=google
GOOGLE_MODEL=gemini-3.5-flash-lite
GOOGLE_MAX_RETRIES=10

EMBEDDING_PROVIDER=google
EMBEDDING_MODEL=gemini-embedding-2
# La dimension tiene que coincidir con la del indice de Pinecone (768 para Gemini, 1536 para text-embedding-3-small)
EMBEDDING_DIMENSION=768

# --- Alternativas de pago (solo si cambias LLM_PROVIDER / EMBEDDING_PROVIDER) ---
# LLM_PROVIDER=anthropic  -> ANTHROPIC_API_KEY, ANTHROPIC_MODEL=claude-opus-5
# LLM_PROVIDER=openai     -> OPENAI_API_KEY, OPENAI_MODEL=gpt-4o-mini
# EMBEDDING_PROVIDER=openai -> OPENAI_API_KEY, EMBEDDING_MODEL=text-embedding-3-small, EMBEDDING_DIMENSION=1536
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# pinecone (por defecto) o memory (sin Pinecone: indexa data/ en memoria al arrancar la API)
VECTOR_STORE=pinecone
PINECONE_API_KEY=tu_api_key_de_pinecone
INDEX_NAME=curso-rag-index
PINECONE_NAMESPACE=documentacion-tecnica
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

REDIS_URL=redis://localhost:6379

MAX_PASOS=6
RECURSION_LIMIT=25
LOG_LEVEL=INFO

# Trazas: Phoenix (docker compose ya lo levanta y lo activa) o LangSmith
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=sistema-final
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=tu_api_key_de_langsmith
LANGCHAIN_PROJECT=sistema-final
