LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=tu_api_key_de_anthropic
ANTHROPIC_MODEL=claude-opus-5
OPENAI_API_KEY=tu_api_key_de_openai
OPENAI_MODEL=gpt-4o-mini

# OPENAI_API_KEY es obligatoria siempre: se usa para los embeddings
EMBEDDING_MODEL=text-embedding-3-small
EMBEDDING_DIMENSION=1536

PINECONE_API_KEY=tu_api_key_de_pinecone
INDEX_NAME=curso-rag-index
PINECONE_NAMESPACE=documentacion-tecnica
PINECONE_CLOUD=aws
PINECONE_REGION=us-east-1

REDIS_URL=redis://localhost:6379

MAX_PASOS=6
RECURSION_LIMIT=25
LOG_LEVEL=INFO

# Trazas: Phoenix (docker compose ya lo levanta y lo activa) o LangSmith
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
PHOENIX_PROJECT_NAME=sistema-final
LANGCHAIN_TRACING_V2=false
LANGCHAIN_API_KEY=tu_api_key_de_langsmith
LANGCHAIN_PROJECT=sistema-final
