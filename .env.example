LLM_PROVIDER=anthropic

ANTHROPIC_API_KEY=tu_api_key_de_anthropic
ANTHROPIC_MODEL=claude-opus-5

OPENAI_API_KEY=tu_api_key_de_openai
OPENAI_MODEL=gpt-4o-mini

REDIS_URL=redis://localhost:6379

# LangSmith (opcion mas simple, no requiere correr nada local)
LANGCHAIN_TRACING_V2=true
LANGCHAIN_API_KEY=tu_api_key_de_langsmith
LANGCHAIN_PROJECT=pre-entrega-7

# Arize Phoenix (opcional, alternativa a LangSmith, corre local con: docker run -p 6006:6006 arizephoenix/phoenix)
PHOENIX_ENABLED=false
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006/v1/traces
