LLM_PROVIDER=anthropic

# Obligatoria siempre: se usa para los embeddings (indexar y consultar),
# incluso si elegis anthropic para generar la respuesta (Anthropic no tiene
# API de embeddings propia).
OPENAI_API_KEY=tu_api_key_de_openai
EMBEDDING_MODEL=text-embedding-3-small

# Solo si LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=tu_api_key_de_anthropic
ANTHROPIC_MODEL=claude-opus-5

# Solo si LLM_PROVIDER=openai
OPENAI_MODEL=gpt-4o-mini
